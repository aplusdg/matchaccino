# Server-only credentials. Copy to .env and supply your values. Never commit .env.
RESEND_API_KEY=
# Use an address on your verified Resend domain, e.g. Matchaccino <desk@yourdomain.com>
EMAIL_FROM=
# Choose one of Maddy’s two inboxes: maddykittyw@gmail.com or terrinobb@gmail.com
REQUEST_RECIPIENT=maddykittyw@gmail.com
PORT=3000

# Only needed if hosting the frontend separately (e.g. GitHub Pages):
# Public HTTPS origin of your Node server. Set at frontend build time.
VITE_API_BASE_URL=
# Set on the backend to allow the exact frontend origin (no trailing slash).
# APP_ORIGIN=https://aplusdg.github.io
APP_ORIGIN=

# Easier alternative: a public Formspree form endpoint (not an API key).
# Fix Maddy's inbox in your Formspree dashboard and verify that inbox first.
VITE_FORM_ENDPOINT=
